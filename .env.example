PORT=3000

# Credenciais administrativas: defina SEMPRE no painel de variáveis do provedor.
# Nunca versione valores reais e nunca reutilize uma senha já publicada.
ADMIN_PASSWORD=

# Preferível a ADMIN_PASSWORD: hash scrypt da senha.
# Gere com: node scripts/gerar-hash-senha.js
ADMIN_PASSWORD_HASH=

# Obrigatório em produção (NODE_ENV=production). Mínimo de 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Opcional: origens extra autorizadas a chamar a API (separadas por vírgula).
ALLOWED_ORIGIN=

# Opcional: caminho do arquivo de dados. Padrão: data/agendamentos.json
# Ignorado quando DATABASE_URL está definida.
DATA_FILE=

# Banco de dados. Quando definida, os agendamentos são gravados no Postgres e o
# arquivo DATA_FILE deixa de ser usado.
# No Render, copie a "Internal Database URL" do banco criado.
# Em produção, é obrigatória: sem ela o serviço usa o arquivo, que se perde a
# cada deploy porque o sistema de arquivos do Render é efêmero.
DATABASE_URL=

# Defina como "false" apenas para um Postgres local sem TLS. Padrão: TLS ligado.
DATABASE_SSL=
